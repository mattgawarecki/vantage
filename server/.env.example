# Copy to server/.env (gitignored) and fill in. The server loads it on boot.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: analyze a repo automatically on startup (else POST /analyze).
# REPO_PATH=/Users/you/projects/excalidraw
# REPO_TARGET=packages/excalidraw

# Optional model overrides (default: claude-opus-4-8 for both).
# VANTAGE_EXPLAIN_MODEL=claude-opus-4-8
# VANTAGE_ASK_MODEL=claude-opus-4-8
